#!/bin/bash

# inspired by: https://stackoverflow.com/a/48507868/1041691
#
#   el2pdf <input.el>
#
# generates <output.pdf>

INPUT=$1
TMP=$(echo "$1" | sed 's/[.]el$/.md/')
OUTPUT=$(echo "$1" | sed 's/[.]el$/.pdf/')

echo '---
header-includes:
 - \usepackage[textwidth=7in]{geometry}
 - \usepackage{fvextra}
 - \DefineVerbatimEnvironment{Highlighting}{Verbatim}{breaklines,commandchars=\\\{\},fontsize=\large}
---

~~~~~{.lisp .numberLines}
' > "$TMP"

cat "$INPUT" >> "$TMP"

echo "~~~~~~" >> "$TMP"

pandoc "$TMP" -V papersize:"letter" -o "$OUTPUT" --highlight-style=haddock
rm "$TMP"
