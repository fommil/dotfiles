#!/bin/bash

# TODO use https://sites.google.com/site/speechrate/ to get the right atempo

TEMPO=${2:-1.5}

# Using https://github.com/inAudible-NG/audible-activator
# ACTIVATION_BYTES=...

# to get the decrypted m4b
if [[ "$1" =~ [.]aa[cx]$ ]] ; then
    OUT="${1%.*}.m4b"
    if [ ! -f "$OUT" ] ; then
        ffmpeg -activation_bytes $ACTIVATION_BYTES -i "$1" -c:a copy -vn "$OUT"
    fi
fi

# sped-up mp3
ffmpeg -activation_bytes ${ACTIVATION_BYTES} -i "$1" -c:a libmp3lame -qscale:a 0 -filter:a "atempo=${TEMPO}" -vn "${1%.*}.${TEMPO}.mp3"
