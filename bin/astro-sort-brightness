#!/bin/bash

# given a folder of Sony ARW images (or fits) this will sort them according to their
# mean pixel values into darks and lights.
#
# Without any parameter this will simply replay back the brightness levels, it must
# be called with a number to do the splitting.

set -euo pipefail
shopt -s nullglob

brightness () {
    f=$1
    case "$f" in
        *.ARW|*.arw)
            thumb=${f%.*}.jpg
            if [ -f "$thumb" ] ; then
                magick "jpeg:$thumb" -format "%[fx:mean]\n" info:
            else
                exiftool -b -PreviewImage "$f" | magick jpeg:- -format "%[fx:mean]\n" info:
            fi
            ;;
        *.fit|*.fits)
            magick "$f[0]" -format "%[fx:mean]\n" info:
            ;;
        *.fz)
            funpack -S "$f" | magick "fits:-[0]" -format "%[fx:mean]\n" info:
            ;;
        *)
            return 1
            ;;
    esac
}

p=${1:-calibrate}
if [ -f "$p" ] ; then
    brightness "$p"
    exit 0
fi

if [ "$p" = "calibrate" ] ; then
    for f in *.ARW *.fit *.fits *.fz ; do
        mean=$(brightness "$f") || continue
        echo "$f : $mean"
    done
    exit 0
fi

for f in *.ARW *.fit *.fits *.fz ; do
    mean=$(brightness "$f") || continue

    if [ "$(awk -v x="$mean" -v y="$p" 'BEGIN{print (x<y)?1:0}')" -eq 1 ] ; then
        mkdir -p darks
        mv -v "$f" darks/
    else
        mkdir -p lights
        mv -v "$f" lights/
    fi
done
