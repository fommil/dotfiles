name:                my-xmonad
version:             0.1.0.0
license:             GPL-3
license-file:        LICENSE
author:              Sam Halliday
maintainer:          sam.halliday@gmail.com
build-type:          Simple
extra-source-files:  ChangeLog.md
cabal-version:       >=1.10

executable my-xmonad
  main-is:             xmonad.hs
  ghc-options:         -O2
  build-depends:       base >=4.11 && <4.12
                       ,xmonad == 0.14.2
                       ,xmonad-contrib == 0.14
                       ,containers
  default-language:    Haskell2010
