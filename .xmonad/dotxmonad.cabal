name:                dotxmonad
version:             0.1.0.0
build-type:          Simple
cabal-version:       >=1.10

executable xmonad-x86_64-linux
  main-is:             xmonad.hs
  ghc-options:         -O2
  build-depends:       base >=4.11 && <4.12
                       ,xmonad == 0.14.2
                       ,xmonad-contrib == 0.14
                       ,containers
  default-language:    Haskell2010
