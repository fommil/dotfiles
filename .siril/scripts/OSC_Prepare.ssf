############################################
#
# Script for Siril 1.2
# February 2023
# (C) Cyril Richard
# Preprocessing v1.3 + changes
#
########### PREPROCESSING SCRIPT ###########
#
# Script for color camera preprocessing.
# Converts files and calibrates light frames.
#
# Needs RAW images in:
#   biases/
#   darks/
#   flats/
#   lights/
#
# This has been adapted from the stock OSC_Preprocessing
# script to:
#
# 1. use gzip compressed fits to save space
# 2. calculate and subtract the background
# 3. halts before registration
#
# It is safe to clean up with
#
# rm -f process/bias_*.fit* process/dark_*.fit* process/flat_*.fit* process/light_*.fit*
#
# and if you don't plan on stacking the raw subs (background retained)
#
# rm -f process/pp_light_*.fit*
#
# and the sequence that can be registered / stacked is called bkg_pp_light.
#
# Siril intentionally does not support file deletion, see
# https://siril.org/faq/#could-you-add-commands-to-delete-files-or-sequences
#
############################################

requires 1.2.0

# this might mess with the user settings
# but it saves a hell of a lot of space
setcompress 1 -type=gzip1 0

# Convert Bias Frames to .fit files
cd biases
convert bias -out=../process
cd ../process

# Stack Bias Frames to bias_stacked.fit
stack bias rej 3 3 -nonorm -out=../masters/bias_stacked
cd ..

# Convert Flat Frames to .fit files
cd flats
convert flat -out=../process
cd ../process

# Calibrate Flat Frames
calibrate flat -bias=../masters/bias_stacked

# Stack Flat Frames to pp_flat_stacked.fit
stack pp_flat rej 3 3 -norm=mul -out=../masters/pp_flat_stacked
cd ..

# Convert Dark Frames to .fit files
cd darks
convert dark -out=../process
cd ../process

# Stack Dark Frames to dark_stacked.fit
stack dark rej 3 3 -nonorm -out=../masters/dark_stacked
cd ..

# Convert Light Frames to .fit files
cd lights
convert light -out=../process
cd ../process

# Calibrate Light Frames
calibrate light -dark=../masters/dark_stacked -flat=../masters/pp_flat_stacked -cc=dark -cfa -equalize_cfa -debayer

# doing background sky removal at the sequence level handles
# local light pollution better than a single pass at the end
seqsubsky pp_light 1

setcompress 0

cd ..
close