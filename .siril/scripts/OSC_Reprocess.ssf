# First run the standard, stock, OSC_Preprocessing
# (or my more minimal OSC_Prepare).
#
# This reruns the registration and stacking stages
# with more aggressive parameters (including doing
# background removal on each sub) and should give
# better results.

requires 1.2.0

cd process

# doing background sky removal at the sequence level handles
# local light pollution better than a single pass at the end
seqsubsky pp_light 1

# 2 pass registration should pick a better reference image
register bkg_pp_light -2pass
seqapplyreg bkg_pp_light

# stacking with wfwhm rejection is an automated way to throw
# away entire bad subs. Adjust 4.0 to whatever your skies + rig allow.
stack r_bkg_pp_light rej 3 3 -norm=addscale -output_norm -rgb_equal -out=result -filter-wfwhm=4.0

load result
cd ..
save reprocessed

close
