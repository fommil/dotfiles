# Does a typical "initial stretch" as per NebulaPhotos.
#
# Next steps, requiring qualitative input are usually:
#
# 1. move the black point
# 2. further gentle stretches around interesting areas
# 3. color saturation

requires 1.2.0

platesolve -localasnet
unclipstars
pcc

# Nico's trademark initial stretch...
#
# This is an aggressive generalised hyperbolic stretch around
# the background (i.e. the median, which is the default for this
# command). Independent channel luminance model.
#
# https://youtu.be/Zx6dd7ESLW8?t=1428
autoghs -linked 0.0 5 -b=10 -lp=0 -hp=1.0
save initial_stretch

# Next is linear black point, then stretch / saturate to taste.
