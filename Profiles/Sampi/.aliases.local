alias update="sudo pacman -Syu ; update-emacs"
alias update-aggressive="yay -Syu --devel --aur ; update-emacs"
alias keepers="sudo pacman -Qqet"
alias keepers-detail='for p in $(pacman -Qqe) ; do desc=$(pacman -Qi $p | grep "^Description" | sed "s/^Description *//") ; echo "$p$desc" ; done'
alias cleanup='sudo pacman -Rsn $(pacman -Qdtq | tr "\n" " ")'
