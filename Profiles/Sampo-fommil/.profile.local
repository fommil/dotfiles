#!/bin/sh

# pyenv installed via pacman
eval "$(pyenv init -pyenv init -)"
eval "$(pyenv virtualenv-init -)"

# jenv installed manually https://www.jenv.be/
export PATH="$HOME/.jenv/bin:$PATH"
eval "$(jenv init -)"

# also update /etc/makepkg.conf
export MAKEFLAGS="-j$(nproc)"
export CFLAGS="-march=native -O3 -pipe -fno-plt"
export CXXFLAGS="$CFLAGS"

export EMACS_SOURCE=$HOME/Projects/emacs
# when building emacs-*-git use this
# source=("$pkgname::git+file:///home/fommil/Projects/emacs#branch=emacs-25")
