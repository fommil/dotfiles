#!/bin/sh

export PATH="$HOME/.cargo/bin:$PATH"

export PATH="$HOME/.pyenv/shims:$HOME/.pyenv/bin:$PATH"

export PATH="$HOME/.gem/ruby/2.7.0/bin:$PATH"

export MAKEFLAGS="-j$(nproc)"
export CFLAGS="-march=native -O3"
export CXXFLAGS="$CFLAGS"

export EMACS_SOURCE=$HOME/Projects/emacs
# when building emacs25-git use this to use my local repo
# source=("$pkgname::git+file:///home/fommil/Projects/emacs#branch=emacs-25")

export PRINTER=HP_Color

# the (jenv init -) thing doesn't work in emacs
export PATH="$HOME/.jenv/shims:$HOME/.jenv/bin:$PATH"

export YOURKIT_AGENT=/opt/YourKit-JavaProfiler-2024.3/bin/linux-x86-64/libyjpagent.so
export ASYNC_PROFILER_DIR=$HOME/Projects/async-profiler
export FLAME_GRAPH_DIR=$HOME/Projects/FlameGraph

export BROWSER=firefox

export GOPATH="$HOME/.go"
export PATH="$GOPATH/bin:$PATH"

# disable anonymous data collection from AWS SAM
export SAM_CLI_TELEMETRY=0
