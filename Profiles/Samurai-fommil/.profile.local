#!/bin/sh

eval "$(pyenv init -)"
eval "$(virtualenv init -)"

export MAKEFLAGS="-j$(nproc)"
export CFLAGS="-march=native -O3"
export CXXFLAGS="$CFLAGS"

export EMACS_SOURCE=$HOME/Projects/emacs
# when building emacs25-git use this to use my local repo
# source=("$pkgname::git+file:///home/fommil/Projects/emacs#branch=emacs-25")

export PRINTER=HP_LaserJet_P2035

export ASYNC_PROFILER_DIR=$HOME/Projects/async-profiler
export FLAME_GRAPH_DIR=$HOME/Projects/FlameGraph
