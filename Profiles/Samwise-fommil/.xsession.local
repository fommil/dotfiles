#!/bin/sh

# if the keyboard is unplugged, all xmodmaps are lost, so check
$HOME/.Xmodmap.hack &

#summer
redshift -m randr -l 56.291:-3.722 -b 1.0:0.7 &
# winter
#redshift -m randr -l 56.291:-3.722 -b 0.9:0.6 &
#
# It's the 18th hole of my local golf course, you didn't think
# I'd be stupid enough to give away my home location, did you?

update-desktop-database ~/.local/share/applications

# to toggle whether we show hidden files or not do
gsettings set org.gtk.Settings.FileChooser show-hidden false

# needed for some apps (e.g. rpi-imager) to gain privileged access
lxpolkit &

# auto disk mounting (under /media/<user>)
devmon &

# compositor that prevents visible tearing (not available in the X11 driver)
picom --backend=glx --vsync &

# my monitor interprets a "blank" as turning off the sound, which
# kills my music. So just don't blank. We could manually simulate
# a screensaver with xrandr brightness if we cared enough.
xset -dpms
xset s off
xset s noblank
xset s 3600 0
xss-lock -- slock &

# autologin with immediate slock
slock &
