alias update="sudo apt update && sudo apt upgrade"
#alias purge='sudo apt-get purge $(dpkg -l | grep \'^rc\' | awk \'{print $2}\')'

alias s3push='aws s3 sync --profile fommil --storage-class STANDARD_IA --size-only --no-guess-mime-type ~/Cloud/ s3://fommil-cloud/'
alias s3pull='aws s3 sync --profile fommil --size-only s3://fommil-cloud/ ~/Cloud/'

alias poweroff='sudo /sbin/poweroff'
alias reboot='sudo /sbin/reboot'

alias git-fommil='git -c core.sshCommand="ssh -i ~/.ssh/id_rsa_fommil"'

alias unmount-all='for f in /media/fommil/* ; do udevil unmount "$f" ; done'
